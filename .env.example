# environment
ENVIRONMENT=local
NAME=Cita Kita Transfer Service
DESCRIPTION=Cita Kita Transfer Service
VERSION=v1.0.0
PREFORK=false
TIMEZONE=UTC
PORT=8000

# database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cita_kita_transfer_service
DB_USER=postgres
DB_PASSWORD=postgres
DB_TABLE_PREFIX=
DB_ENABLE_MIGRATION=true

# cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_INDEX=0
CACHE_TTL_SECONDS=3600

MAX_RETRIES=3
RETRY_BASE_BACKOFF=1s
BATCH_CONCURRENT=false